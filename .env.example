# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server port (default 3000)
PORT="3000"

# Secret key used for signing session tokens and document preview tokens
AUTH_SECRET="your-secure-jwt-secret-key-change-in-production"

# Configurable WhatsApp verification provider (e.g., Twilio, Gupshup, UltraMsg, Wati, or Meta Cloud API)
WHATSAPP_PROVIDER="meta_cloud" # options: meta_cloud, twilio, ultramsg, mock_webhook
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# Private Document Storage Directory
STORAGE_DIR="./uploads"

# Windows Printing Agent pairing secret salt
AGENT_SALT="qr-print-windows-agent-salt"
