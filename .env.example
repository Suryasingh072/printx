# Render / Cloud Production Environment Variables
# In sabhi variables ke automatic default values code ke andar already set hain.
# Agar Render ya Vercel aapse mang raha hai, toh aap neeche diye gaye values copy-paste kar sakte hain:

# 1. Session Auth Security Key (Aap koi bhi random text daal sakte hain)
AUTH_SECRET="adrtech-printqr-auth-session-key-2026-production"

# 2. WhatsApp OTP Provider (Default: mock_webhook / test mode)
WHATSAPP_PROVIDER="mock_webhook"
WHATSAPP_API_KEY=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WEBHOOK_SECRET=""

# 3. Upload Directory (Render persistent disk ya temp storage)
STORAGE_DIR="./uploads"

# 4. Windows Agent Salt Key
AGENT_SALT="qr-print-windows-agent-salt"

# 5. Port (Render automatically PORT provide karta hai)
PORT="3000"
NODE_ENV="production"

# 6. Supabase Cloud Database (Cloud Persistence)
SUPABASE_URL="https://ovyimgjzfzhysyubqycw.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_ANON_KEY=""

# 7. Razorpay Standard Web Checkout
RAZORPAY_KEY_ID="rzp_live_TsAzwEO7ucpLWe"
RAZORPAY_KEY_SECRET=""
VITE_RAZORPAY_KEY_ID="rzp_live_TsAzwEO7ucpLWe"
